{
    "name": "cac-council",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "CAC 议会 · 零依赖静态站点",
    "scripts": {
        "build": "node site/build.mjs",
        "build:wasm": "asc site/assets/games/shift-at-midnight/src/shift.ts -o site/assets/games/shift-at-midnight/shift.wasm -O3 --runtime stub --noAssert",
        "serve": "node site/serve.mjs",
        "dev": "node site/build.mjs && node site/serve.mjs",
        "check": "node tools/check-content.mjs",
        "test": "node test/all.mjs",
        "verify": "node test/all.mjs && node tools/check-content.mjs",
        "check:text": "node tools/check-text.mjs"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "assemblyscript": "^0.28.20",
        "pangu": "^10.4.1",
        "zhlint": "^0.8.2"
    }
}
